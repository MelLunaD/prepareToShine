<section class="acceso acceso-perfil">

    {{#es_propio}}
        <h1 class="titulo-juego">Mi <span class="palabra-fase" data-die="Alma">Perfil</span></h1>
    {{/es_propio}}
    {{^es_propio}}
        <h1 class="titulo-juego"><span data-die="Alma">Perfil</span> de <span class="palabra-fase" data-die="Jugador">Jugador</span></h1>
    {{/es_propio}}

    {{#perfil}}
    <div class="tarjeta tarjeta-perfil">

        {{#exito}}
            <div class="alerta alerta-exito">{{exito}}</div>
        {{/exito}}

        <div class="perfil-cabecera">
            <img class="perfil-avatar" src="{{foto}}" alt="Foto de {{usuario}}" width="88" height="88">
            <div class="perfil-identidad">
                <h2 class="perfil-nombre">{{nombre_completo}}</h2>
                <p class="perfil-usuario">@{{usuario}}</p>
            </div>
        </div>

        {{#resumen}}
        <!-- Rango y números del modo del tema activo: Shine o Die (.solo-shine / .solo-souls). -->
        <div class="solo-shine">{{#shine}}{{> perfilModo}}{{/shine}}</div>
        <div class="solo-souls">{{#die}}{{> perfilModo}}{{/die}}</div>
        {{/resumen}}

        {{#tiene_ubicacion}}
        <div class="perfil-ubicacion">
            <p class="perfil-ubicacion-texto">
                <img class="perfil-bandera" src="https://flagcdn.com/w20/{{pais_codigo_min}}.png" alt="{{pais_codigo}}">
                {{#ubicacion_texto}}{{ubicacion_texto}}, {{/ubicacion_texto}}{{pais_nombre}}
            </p>
            {{#es_propio}}
            <div id="mapa" class="mapa" data-modo="ver" data-lat="{{latitud}}" data-lng="{{longitud}}"></div>
            {{/es_propio}}
            {{^es_propio}}
            <div id="mapa" class="mapa" data-modo="zona" data-lugar="{{osm_lugar}}" data-busqueda="{{ubicacion_busqueda}}"></div>
            {{/es_propio}}
        </div>
        {{/tiene_ubicacion}}
        {{^tiene_ubicacion}}
            {{#es_propio}}
            <p class="perfil-ubicacion-texto">Todavía no marcaste tu ubicación. Podés agregarla desde <a href="/perfil/editar">Editar perfil</a>.</p>
            {{/es_propio}}
        {{/tiene_ubicacion}}

        {{#es_propio}}
        <ul class="perfil-datos">
            <li>
                <span class="dato-label">País</span>
                <strong class="dato-valor">
                    <img class="perfil-bandera" src="https://flagcdn.com/w20/{{pais_codigo_min}}.png" alt="{{pais_codigo}}">
                    {{pais_nombre}} ({{pais_codigo}})
                </strong>
            </li>
            <li>
                <span class="dato-label">Año de nacimiento</span>
                <strong class="dato-valor">{{anio_nacimiento}}</strong>
            </li>
            <li>
                <span class="dato-label">Sexo</span>
                <strong class="dato-valor">{{sexo_legible}}</strong>
            </li>
            <li>
                <span class="dato-label">Mail</span>
                <strong class="dato-valor">{{email}}</strong>
            </li>
            <li>
                <span class="dato-label">Miembro desde</span>
                <strong class="dato-valor">{{fecha_alta_formateada}}</strong>
            </li>
        </ul>

        {{#qr_imagen}}
        <div class="perfil-qr-caja">
            <img class="perfil-qr-img" src="{{qr_imagen}}" alt="Código QR de @{{usuario}}" width="140" height="140">
            <div class="perfil-qr-info">
                <strong>Compartir perfil</strong>
                <p>Escaneá este código QR para ver la ficha pública de <strong>@{{usuario}}</strong>.</p>
                <a href="{{url_publica}}" class="perfil-qr-link">Ver enlace público</a>
            </div>
        </div>
        {{/qr_imagen}}

        {{! "Quiero moderar": solo aparece si cumple el requisito, o si ya lo pidió. }}
        {{#moderar}}
        <div class="perfil-moderar">
            <strong class="perfil-moderar-titulo">Moderar preguntas</strong>
            {{#puede}}
                {{! El jugador nunca ve el requisito: solo que ya puede pedirlo. }}
                <p>¿Querés estar del otro lado? Podés pedir ser moderador y ayudar a mejorar el juego.</p>
                <form method="post" action="/perfil/moderar">
                    <input type="hidden" name="modo" value="{{modo}}">
                    <button type="submit" class="btn btn-secundario">Quiero moderar</button>
                </form>
            {{/puede}}
            {{#pendiente}}
                <p>Pediste ser moderador el {{fecha}}. Un administrador va a revisar tu solicitud.</p>
            {{/pendiente}}
            {{#rechazada}}
                <p>Esta vez no aprobaron tu solicitud. Podés volver a pedirlo desde el lunes.</p>
            {{/rechazada}}
        </div>
        {{/moderar}}

        <a href="/perfil/editar" class="btn btn-primario">Editar perfil</a>
        {{/es_propio}}

        <p class="pie-formulario"><a href="/">Volver al inicio</a></p>
    </div>
    {{/perfil}}

</section>