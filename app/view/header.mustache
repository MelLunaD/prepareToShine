<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Prepare to {{palabraFase}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Nunito:wght@400;700;800&family=Cinzel:wght@700&family=EB+Garamond&display=swap">
    {{#usaMapa}}<link rel="stylesheet" href="/public/css/vendor/leaflet.css">{{/usaMapa}}
    <link rel="stylesheet" href="/public/css/estilos.css">
</head>
<body class="tema-{{tema}}">

<header class="hud">
    <a href="/" class="hud-logo">
        <img src="/public/img/estrella.svg" alt="">
        <span>Prepare to <span class="palabra-fase">{{palabraFase}}</span></span>
    </a>
    {{#sesion}}
        <nav class="hud-jugador">
            <a href="/perfil" class="hud-perfil-link">
                <span class="hud-nombre">{{usuario}}</span>
                <img class="hud-foto" src="{{foto}}" alt="Foto de {{usuario}}">
            </a>
            <a class="hud-salir" href="/login/logout" title="Cerrar sesión" aria-label="Cerrar sesión">
                <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" shape-rendering="crispEdges">
                    <path fill="currentColor" d="M7 1h2v7H7zM4 3h2v2H5v1H4v4h1v1h1v1h4v-1h1v-1h1V6h-1V5h-1V3h2v1h1v1h1v6h-1v1h-1v1h-1v1H5v-1H4v-1H3v-1H2V5h1V4h1z"/>
                </svg>
            </a>
        </nav>
    {{/sesion}}
</header>

<main class="escenario">
    <img class="nube nube-1" src="/public/img/nube.svg" alt="" aria-hidden="true">
    <img class="nube nube-2" src="/public/img/nube.svg" alt="" aria-hidden="true">
    <img class="nube nube-3" src="/public/img/nube.svg" alt="" aria-hidden="true">
