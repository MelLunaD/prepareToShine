<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Prepare to {{palabraFase}}</title>
    <link rel="icon" href="/public/img/favicon-{{tema}}.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Nunito:wght@400;700;800&family=Cinzel:wght@700&family=EB+Garamond&display=swap">
    {{#usaMapa}}<link rel="stylesheet" href="/public/css/vendor/leaflet.css">{{/usaMapa}}
    <link rel="stylesheet" href="/public/css/estilos.css?v={{version}}">
</head>
<body class="tema-{{tema}}">

<header class="hud">
    <a href="/" class="hud-logo">
        <img src="/public/img/estrella.svg" alt="">
        <span>Prepare to <span class="palabra-fase">{{palabraFase}}</span></span>
    </a>
    {{#sesion}}
        <nav class="hud-jugador">
            <a href="/perfil" class="hud-perfil-link">
                <span class="hud-nombre">{{usuario}}</span>
                <img class="hud-foto" src="{{foto}}" alt="Foto de {{usuario}}">
            </a>
            <!-- Menú hamburguesa: <details> se abre y cierra solo, sin JavaScript
                 (public/js/menu.js solo lo cierra al tocar afuera o con Escape). -->
            <details class="hud-menu">
                <summary class="hud-menu-boton" aria-label="Abrir menú" title="Menú">
                    <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true" shape-rendering="crispEdges">
                        <path fill="currentColor" d="M2 3h12v2H2zM2 7h12v2H2zM2 11h12v2H2z"/>
                    </svg>
                </summary>
                <ul class="hud-menu-lista">
                    <!-- Sonido en el celular: en pantallas grandes estos dos se esconden y se usan
                         los botones fijos de abajo a la izquierda. sonidos.js cambia Sí/No. -->
                    <li class="hud-menu-sonido">
                        <button type="button" data-sonido-toggle="musica" aria-pressed="true">
                            {{> iconoMusica}}
                            Música <span class="hud-menu-estado" data-sonido-estado>Sí</span>
                        </button>
                    </li>
                    <li class="hud-menu-sonido">
                        <button type="button" data-sonido-toggle="efectos" aria-pressed="true">
                            {{> iconoEfectos}}
                            Efectos <span class="hud-menu-estado" data-sonido-estado>Sí</span>
                        </button>
                    </li>
                    <!-- Home: el lobby del modo que se está viendo (en Die vuelve al lobby de Die). -->
                    <!-- El administrador no tiene lobby: su "home" es Administrar. -->
                    {{^esAdmin}}
                    <li class="solo-shine"><a href="/">Home</a></li>
                    <li class="solo-souls"><a href="/?modo=die">Home</a></li>
                    {{/esAdmin}}
                    <li><a href="/perfil">Mi perfil</a></li>
                    <!-- El ranking del modo que se está viendo: el CSS muestra el link del tema activo. -->
                    <li class="solo-shine"><a href="/ranking?modo=shine">Ranking</a></li>
                    <li class="solo-souls"><a href="/ranking?modo=die">Ranking</a></li>
                    {{#esEditor}}<li><a href="/editor">Moderar</a></li>{{/esEditor}}
                    {{#esAdmin}}<li><a href="/admin">Administrar</a></li>{{/esAdmin}}
                    <li class="hud-menu-salir">
                        <a href="/login/logout">
                            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" shape-rendering="crispEdges">
                                <path fill="currentColor" d="M7 1h2v7H7zM4 3h2v2H5v1H4v4h1v1h1v1h4v-1h1v-1h1V6h-1V5h-1V3h2v1h1v1h1v6h-1v1h-1v1h-1v1H5v-1H4v-1H3v-1H2V5h1V4h1z"/>
                            </svg>
                            Cerrar sesión
                        </a>
                    </li>
                </ul>
            </details>
        </nav>
    {{/sesion}}
</header>

<!-- Botones de sonido fijos abajo a la izquierda: en compu siempre; en celular solo cuando no hay
     sesión (sin sesión no hay menú hamburguesa donde ponerlos). Música = los loops de fondo;
     Efectos = todo lo demás. sonidos.js los prende/apaga y recuerda la elección. -->
<div class="sonido-esquina{{^sesion}} sonido-esquina-sin-menu{{/sesion}}">
    <button type="button" class="sonido-btn" data-sonido-toggle="musica" aria-pressed="true" title="Música" aria-label="Música">
        {{> iconoMusica}}
    </button>
    <button type="button" class="sonido-btn" data-sonido-toggle="efectos" aria-pressed="true" title="Efectos de sonido" aria-label="Efectos de sonido">
        {{> iconoEfectos}}
    </button>
</div>

<main class="escenario">
    <img class="nube nube-1" src="/public/img/nube.svg" alt="" aria-hidden="true">
    <img class="nube nube-2" src="/public/img/nube.svg" alt="" aria-hidden="true">
    <img class="nube nube-3" src="/public/img/nube.svg" alt="" aria-hidden="true">
    <div class="contenido">
