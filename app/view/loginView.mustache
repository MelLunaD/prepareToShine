<section class="acceso">

    <h1 class="titulo-juego">Prepare to <span class="palabra-fase">{{palabraFase}}</span></h1>

    <div class="tarjeta">
        <h2>Iniciar sesión</h2>

        {{#aviso}}
            <p class="alerta alerta-ok">{{aviso}}</p>
        {{/aviso}}
        {{#error}}
            <p class="alerta alerta-error">{{error}}</p>
        {{/error}}

        <form class="formulario" method="post" action="/login/login">
            <label for="usuario">Usuario</label>
            <input id="usuario" type="text" name="usuario" value="{{usuario}}" autocomplete="username" required autofocus>

            <label for="password">Contraseña</label>
            <input id="password" type="password" name="password" autocomplete="current-password" required>

            <button type="submit" class="btn btn-primario">Entrar</button>
        </form>

        <p class="pie-formulario">¿Primera vez? <a href="/registro">Creá tu cuenta</a></p>
    </div>

</section>
