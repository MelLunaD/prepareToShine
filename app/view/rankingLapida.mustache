<li class="lapida adorno-{{adorno}}{{#esYo}} es-yo{{/esYo}}">
    <span class="lapida-yace"><span class="lapida-puesto">#{{puesto}}</span> · Aquí yace</span>
    <a class="lapida-nombre" href="{{urlPerfil}}" data-miniperfil="{{dialogo}}">{{usuario}}</a>
    <span class="lapida-muertes">{{textoMuertes}}</span>
    <q class="lapida-frase">{{frase}}</q>
    <span class="lapida-causa">Causa de muerte: {{causa}}</span>
    <span class="lapida-fecha">† {{fechaUltima}}</span>
</li>
