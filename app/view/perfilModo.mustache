<div class="perfil-rango">{{> rangoCaja}}</div>
<div class="perfil-stats">
    <div class="stat-caja stat-puntaje">
        <span class="stat-etiqueta">
            <img src="/public/img/{{#esDie}}hoguera{{/esDie}}{{^esDie}}estrella{{/esDie}}.svg" alt="" width="18" height="18">
            {{#esDie}}Almas de la semana{{/esDie}}{{^esDie}}Puntos de la semana{{/esDie}}
        </span>
        <span class="stat-valor">{{puntosSemana}}</span>
    </div>
    <div class="stat-caja stat-partidas">
        <span class="stat-etiqueta">
            <img src="/public/img/{{#esDie}}calavera{{/esDie}}{{^esDie}}moneda{{/esDie}}.svg" alt="" width="18" height="18">
            Partidas de la semana
        </span>
        <span class="stat-valor">{{partidasSemana}}</span>
    </div>
    <div class="stat-caja stat-racha">
        <span class="stat-etiqueta">
            <img src="/public/img/{{#esDie}}lapida{{/esDie}}{{^esDie}}bloque{{/esDie}}.svg" alt="" width="18" height="18">
            Racha actual
        </span>
        <span class="stat-valor">{{rachaActual}}</span>
    </div>
</div>
<!-- De toda la historia en este modo (como el ranking histórico, sin enfriamiento). -->
<div class="perfil-stats perfil-stats-totales">
    <div class="stat-caja">
        <span class="stat-etiqueta">{{#esDie}}Almas totales{{/esDie}}{{^esDie}}Puntos totales{{/esDie}}</span>
        <span class="stat-valor">{{puntosTotales}}</span>
    </div>
    <div class="stat-caja">
        <span class="stat-etiqueta">Partidas jugadas</span>
        <span class="stat-valor">{{partidasTotales}}</span>
    </div>
</div>
